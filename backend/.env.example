APP_NAME="Haske Pay"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Lagos

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# Local dev uses SQLite. Production: mysql (see docker-compose.yml).
DB_CONNECTION=sqlite
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=haske
# DB_USERNAME=haske
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false

# Production: redis for both
QUEUE_CONNECTION=database
CACHE_STORE=file
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# ---- Haske -------------------------------------------------------------
# fake = every provider simulated in-process (no keys, no money).
# live = real VTpass / Baxi / Paystack / Termii calls.
HASKE_PROVIDER_MODE=fake
# Override per integration, e.g. real VTpass sandbox with simulated Paystack and SMS:
# HASKE_BILLS_MODE=live
# HASKE_PAYMENTS_MODE=fake
# HASKE_SMS_MODE=fake

HASKE_DAILY_LIMIT_CUSTOMER=20000000   # kobo (₦200,000)
HASKE_DAILY_LIMIT_AGENT=200000000     # kobo (₦2,000,000)
HASKE_PIN_LOCK_MINUTES=30
HASKE_LOW_BALANCE_ALERT=20000000      # kobo (₦200,000)
HASKE_ALERT_PHONES=                   # comma-separated, get SMS alerts
HASKE_SUPPORT_WHATSAPP=+2348000000000

# VTpass: sandbox https://sandbox.vtpass.com/api · live https://vtpass.com/api
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=

BAXI_BASE_URL=https://api.staging.baxi-services.com/api/baxipay
BAXI_API_KEY=
BAXI_AGENT_ID=

# Paystack: webhook URL to register is {APP_URL}/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_DVA_BANK=wema-bank
PAYSTACK_PLACEHOLDER_EMAIL_DOMAIN=customers.haske.ng

TERMII_API_KEY=
TERMII_SENDER_ID=Haske
TERMII_CHANNEL=dnd

VITE_APP_NAME="${APP_NAME}"
